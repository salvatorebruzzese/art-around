{
  "name": "art-around",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && npx tsc && cp .env dist && npm run build:marketplace && npm run build:navigator && npm run build:home && npm run build:access",
    "build:access": "cd access && npm run build",
    "build:home": "cd home && npm run build",
    "build:marketplace": "cd marketplace && npm run build",
    "build:navigator": "cd navigator && npm run build",
    "start": "cd dist && node backend/index.js",
    "build:start": "npm run build && npm run start",
    "build:start:access": "npx tsc && npm run build:home && npm run start",
    "build:start:home": "npx tsc && npm run build:home && npm run start",
    "build:start:marketplace": "npx tsc && npm run build:marketplace  && npm run start",
    "build:start:navigator": "npx tsc && npm run build:navigator && npm run start",
    "install:all": "npm install && cd marketplace && npm install && cd ../navigator && npm install && cd ../home && npm install",
    "fix": "find . -type d -name node_modules -prune -o -name package.json -execdir npm audit --no-fund fix \\;",
    "test": "npx vitest run"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.0",
    "express-session": "^1.19.0",
    "handlebars": "^4.7.7",
    "mongodb": "^4.5.0",
    "mongoose": "^7.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "path": "^0.12.7",
    "purify-ts": "^2.1.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/css": "^1.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^25.6.0",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "daisyui": "^5.7.16",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.4"
  }
}
