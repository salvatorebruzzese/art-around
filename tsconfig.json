{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,

    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["*.ts", "./**/*.ts"],
  "exclude": ["*.test.ts", "backend/**/*.test.ts"]
}
