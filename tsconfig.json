{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,

    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "*.ts",
    "./**/*.ts",
    "marketplace/router.js",
    "marketplace/index.js",
    "marketplace/form.js"
  ],
  "exclude": ["*.test.ts", "src/**/*.test.ts"]
}
