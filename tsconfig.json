{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "*.ts",
    "app/*.ts",
    "navigator/*.ts",
    "marketplace/*.ts",
    "backend/*.ts",
    "backend/**/*.ts"
  ],
  "exclude": ["*.test.ts"]
}
